# CyberGen — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to use the built-in offline MockLLM for demos/tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ── Optional overrides ────────────────────────────────────────────────────────
# All paths default to pipeline/data/. Override here if needed.
# CHROMA_PERSIST_DIR=pipeline/data/chroma
# QUARANTINE_FILE=pipeline/data/quarantine.json
# AUDIT_FILE=pipeline/data/audit.jsonl
